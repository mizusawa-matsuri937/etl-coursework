# 复制为 .env 后填写；.env 已被 .gitignore 忽略，不要提交真实密码。
# 密码示例：openssl rand -hex 16

# --- 数据库口令（三套角色互相隔离） ---
POSTGRES_PASSWORD=
ETL_DB_PASSWORD=
AIRFLOW_DB_PASSWORD=
TEST_DB_PASSWORD=

# --- Airflow 密钥 ---
# Fernet：python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AIRFLOW_FERNET_KEY=
AIRFLOW_JWT_SECRET=

# --- 输入文件（宿主机路径，只读挂载到 /data/source） ---
SOURCE_HOST_DIR=
SOURCE_GZIP_NAME=movies.txt.gz
SOURCE_MANIFEST_NAME=movies.txt.gz.download.json

# --- 任务 4：IMDb 快照（宿主机路径，只读挂载到 /data/imdb；下载前需用户许可，见 scripts/fetch_imdb.py） ---
# 指向包含 <下载日期>/ 子目录的父目录，例如 ../imdb；留空时挂载 tests/fixtures/task4（里面没有快照，只让容器能启动）。
IMDB_HOST_DIR=

# --- 可选：任务 2 爬虫容器的出网代理（本机容器无外部 DNS 时需要；compose 的 crawler 服务读取） ---
# 例：宿主本机代理 1082 端口 → CRAWL_PROXY_URL=http://host.docker.internal:1082
CRAWL_PROXY_URL=
# 多个出口（换 IP）：逗号分隔，设置后优先；同一轮换网关可写多次当作多个并发出口。容器内无外部 DNS，远程代理建议写 IP。
CRAWL_PROXY_URLS=
# 机场订阅链接（scripts/crawl_mihomo.py 用它生成 mihomo 多端口配置，每个端口一个节点）
CRAWL_SUBSCRIPTION_URL=

# --- 可选：宿主机端口（仅绑定 127.0.0.1） ---
POSTGRES_HOST_PORT=5432
AIRFLOW_HOST_PORT=8080
